{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@expressive/dom"
  },
  "include": ["app.tsx", "classic.tsx", "defaults.tsx"]
}
