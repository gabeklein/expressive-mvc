{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@expressive/dev",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "paths": {
      "@expressive/dev/*": [
        "../src/*"
      ],
      "@expressive/mvc/*": [
        "../../mvc/src/*"
      ],
      "@expressive/dom/*": [
        "../../dom/src/*"
      ],
      "@expressive/*": [
        "../../*/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
