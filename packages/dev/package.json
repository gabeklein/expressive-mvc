{
  "name": "@expressive/dev",
  "version": "0.0.0",
  "description": "Vite host for Expressive apps: file-based routes on @expressive/dom and a server lane.",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "Gabe Klein",
    "email": "gabe@expressive.dev",
    "url": "https://github.com/gabeklein"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabeklein/expressive-mvc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "expressive": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "tsc --noEmit && vitest run",
    "example": "bun run build && node dist/cli.js dev"
  },
  "dependencies": {
    "@expressive/inspect": "workspace:^",
    "es-module-lexer": "^1.6.0",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "@expressive/dom": "^0.2.0",
    "@expressive/mvc": "^0.87.0",
    "@expressive/router": "^0.9.1"
  },
  "devDependencies": {
    "@expressive/dom": "workspace:^",
    "@expressive/mvc": "workspace:^",
    "@expressive/router": "workspace:^",
    "@types/node": "^25.2.0",
    "tsdown": "^0.20.1"
  }
}
