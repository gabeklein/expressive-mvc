{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@expressive/dev",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "@expressive/dev": ["./src"],
      "@expressive/dev/*": ["./src/*"],
      "@expressive/mvc/*": ["../mvc/src/*"],
      "@expressive/dom/*": ["../dom/src/*"],
      "@expressive/router/*": ["../router/src/*"],
      "@expressive/inspect/*": ["../inspect/src/*"],
      "@expressive/*": ["../*/src"]
    }
  },
  "exclude": ["node_modules", "dist", "vitest.config.ts", "tsdown.config.ts"]
}
