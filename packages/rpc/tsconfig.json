{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "@expressive/mvc/*": ["../mvc/src/*"],
      "@expressive/*": ["../*/src"]
    }
  },
  "exclude": ["node_modules", "dist", "vitest.config.ts", "tsdown.config.ts"]
}
