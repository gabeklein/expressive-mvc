{
  "name": "@expressive/rpc",
  "version": "0.1.1",
  "description": "Typed server calls for any Vite client build: a folder of async functions, stubs on the client, a Worker or Node server bundle.",
  "license": "MIT",
  "author": {
    "name": "Gabe Klein",
    "email": "gabe@expressive.dev",
    "url": "https://github.com/gabeklein"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabeklein/expressive.git"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.server.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.server.js",
      "worker": "./dist/index.server.js",
      "node": "./dist/index.server.js",
      "browser": "./dist/index.client.js",
      "default": "./dist/index.server.js"
    },
    "./calls": {
      "types": "./dist/calls.d.ts",
      "default": "./dist/calls.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "coverage": "vitest run --coverage",
    "test": "bun run typecheck && bun run coverage",
    "example": "cd example && vite",
    "example:build": "cd example && vite build",
    "example:e2e": "cd example && bun run e2e"
  },
  "dependencies": {
    "es-module-lexer": "^1.6.0"
  },
  "peerDependencies": {
    "@expressive/mvc": "^0.94.2",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expressive/mvc": "workspace:*",
    "@types/node": "^25.2.0",
    "tsdown": "^0.20.1",
    "vite": "^8.0.0"
  },
  "keywords": [
    "expressive",
    "rpc",
    "vite",
    "cloudflare-workers",
    "server-functions"
  ],
  "publishConfig": {
    "access": "public"
  }
}
