{
  "compilerOptions": {
    "target": "es2020",
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@expressive/mvc",
    "lib": ["ES2020", "dom"],
    "moduleResolution": "bundler",
    "declaration": false,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "strict": true,
    "types": [],
    "paths": {
      "@expressive/mvc/*": ["../mvc/src/*"],
      "@expressive/*": ["../*/src"]
    }
  },
  "exclude": ["node_modules", "dist", "vitest.config.ts"]
}
