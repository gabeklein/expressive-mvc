{
  "compilerOptions": {
    "target": "es2020",
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "declaration": false,
    "noUnusedLocals": true,
    "strict": true,
    "types": [],
    "lib": [
      "ES2023",
      "dom"
    ],
    "paths": {
      "@expressive/mvc": [
        "./src/index.ts"
      ],
      "@expressive/mvc/*": [
        "./src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts"
  ]
}
