{
  "name": "@expressive/react",
  "version": "0.88.0",
  "description": "Class-based reactive state for React. Define models as plain classes; components update when the values they read change.",
  "keywords": [
    "expressive",
    "mvc",
    "react",
    "react-native",
    "expo",
    "state",
    "state-management",
    "reactive",
    "observable",
    "model"
  ],
  "license": "MIT",
  "author": {
    "name": "Gabe Klein",
    "email": "gabe@termtm.com",
    "url": "https://github.com/gabeklein"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabeklein/expressive-mvc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/*.ts",
    "./dist/index.js",
    "./dist/adapter.js",
    "./dist/chunk-*.js"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run --coverage",
    "test": "bun run typecheck && bun run unit"
  },
  "devDependencies": {
    "@expressive/mvc": "^0.87.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-refresh": "^0.14.7",
    "react": "^19",
    "react-dom": "^19",
    "react-refresh": "^0.18.0",
    "tsdown": "^0.20.1",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "@expressive/mvc": "^0.87.0",
    "react": ">=16.14.0 <20.0.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
